{
  "$meta": {
    "name": "Vaishnavi Agencies — Distribution System Design Tokens",
    "version": "1.0.0",
    "primary": "#D71920",
    "themes": ["light", "dark"],
    "source": "Implemented as CSS variables in frontend/src/index.css (:root = light, .dark = dark) and mapped in tailwind.config.js."
  },
  "color": {
    "brand": {
      "value": "#D71920",
      "light": { "DEFAULT": "#D71920", "light": "#F0333A", "dark": "#A81218", "soft": "#FDE8E9" },
      "dark": { "DEFAULT": "#FF4B50", "light": "#FF6E72", "dark": "#D71920", "soft": "#2A1011" }
    },
    "surface": {
      "light": { "bg": "#F6F7F9", "surface": "#FFFFFF", "surface-2": "#F1F3F5", "border": "#E4E7EC" },
      "dark": { "bg": "#0B0B0C", "surface": "#161618", "surface-2": "#1E1E21", "border": "#2A2A2E" }
    },
    "text": {
      "light": { "text": "#15181D", "sub": "#5B6470", "muted": "#828B98" },
      "dark": { "text": "#F2F3F5", "sub": "#A6ADB8", "muted": "#6B7280" }
    },
    "semantic": {
      "light": { "success": "#16A34A", "warning": "#D97706", "danger": "#DC2626", "info": "#2563EB" },
      "dark": { "success": "#22C55E", "warning": "#F59E0B", "danger": "#EF4444", "info": "#3B82F6" }
    }
  },
  "spacing": {
    "scale": "4px base",
    "values": { "0.5": "2px", "1": "4px", "2": "8px", "3": "12px", "3.5": "14px", "4": "16px", "5": "20px", "6": "24px", "7": "28px", "8": "32px" }
  },
  "typography": {
    "fontFamily": { "head": "Barlow Condensed", "body": "Barlow" },
    "scale": {
      "display": "clamp(2rem, 8vw, 3rem) / 800 (head)",
      "h1": "clamp(1.35rem, 5vw, 1.9rem) / 800 (head)",
      "h2": "1.25rem / 700 (head)",
      "title": "1rem / 700 (head)",
      "body": "0.875rem / 400-500 (body)",
      "label": "0.72rem / 600 uppercase tracking-wide",
      "caption": "0.65rem / 500"
    }
  },
  "radius": { "sm": "6px", "md": "8px", "lg": "12px", "xl": "16px", "card": "16px", "xl2": "20px", "full": "9999px" },
  "shadow": {
    "card-light": "0 1px 2px rgb(16 24 40 / 0.04), 0 4px 16px rgb(16 24 40 / 0.06)",
    "elev-light": "0 8px 30px rgb(16 24 40 / 0.12)",
    "card-dark": "0 1px 2px rgb(0 0 0 / 0.4), 0 8px 24px rgb(0 0 0 / 0.45)",
    "elev-dark": "0 12px 40px rgb(0 0 0 / 0.6)",
    "glow": "0 0 0 1px rgb(brand / 0.25), 0 8px 30px rgb(brand / 0.18)"
  },
  "motion": {
    "page": { "duration": "180ms", "easing": "ease-out", "effect": "fade + 8px slide-up" },
    "cardHover": { "duration": "150ms", "transform": "translateY(-2px)", "extra": "shadow lift" },
    "skeleton": { "duration": "1.2s", "type": "shimmer sweep" },
    "counter": { "duration": "800ms", "easing": "easeOutCubic", "from": 0 },
    "drawer": { "duration": "250ms", "easing": "cubic-bezier(0.22,1,0.36,1)", "type": "spring slide-up" },
    "toast": { "duration": "200ms", "effect": "slide + fade" },
    "reducedMotion": "All durations collapse to ~0 under prefers-reduced-motion"
  },
  "icons": {
    "library": "lucide-react",
    "defaultSize": 18,
    "strokeWidth": { "default": 2, "active": 2.4 },
    "rationale": "Replaced emoji with monoline SVG icons for consistency, theming, and accessibility."
  },
  "accessibility": {
    "contrast": "WCAG AA (>= 4.5:1 body, 3:1 large) across light & dark",
    "touchTarget": ">= 38-44px",
    "focus": "2px brand outline, 2px offset, focus-visible only"
  }
}
