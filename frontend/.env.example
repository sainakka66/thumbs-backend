# ── Production (Vercel) — required for production builds ─────────────
VITE_API_BASE_URL=https://thumbs-backend.onrender.com

# ── Local development (recommended) ───────────────────────────────────
# Do NOT set VITE_API_BASE_URL in .env — app uses /api + Vite proxy:
#   http://localhost:5173/api/login  →  https://thumbs-backend.onrender.com/login
#
# This avoids clashing with the React route /login (which returns index.html).

# VITE_API_PROXY_TARGET=https://thumbs-backend.onrender.com

# Optional: bypass proxy and call Render directly (needs CORS on backend)
# VITE_USE_DIRECT_API=true
# VITE_API_BASE_URL=https://thumbs-backend.onrender.com
