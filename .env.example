# ── Server (Render / local) ─────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Required in production (min 32 characters). Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Comma-separated extra frontend origins (built-in defaults include Vercel + localhost:5173)
CORS_ORIGINS=https://thumbs-up-app-two.vercel.app

# Login rate limit (per IP, 15-minute window)
LOGIN_RATE_LIMIT_MAX=10

# Extra usernames to block (comma-separated, lowercase)
# DISABLED_USERNAMES=demo_account,test_user

# bcrypt cost factor (10–12 recommended)
BCRYPT_ROUNDS=12

# ── Database (Railway / MySQL) — use ONE of these approaches ─────────
# Option A: single URL
DATABASE_URL=mysql://user:password@host:port/database

# Option B: individual variables (Railway often exposes these)
# MYSQLHOST=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# MYSQLPORT=3306

# ── One-off password hashing script ─────────────────────────────────
# ADMIN_NEW_PASSWORD=YourStr0ng!Pass12

# ── Local QA / security scripts (never commit real values) ──────────
# API_URL=http://localhost:3000
# TEST_USERNAME=
# TEST_PASSWORD=
