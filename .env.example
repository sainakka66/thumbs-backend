# ── Server (Render / local) ─────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Required in production (min 32 characters). Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Comma-separated extra frontend origins (built-in defaults include Vercel + localhost:5173)
CORS_ORIGINS=https://thumbs-up-app-two.vercel.app

# Login rate limit — optional override when rate_limit_settings table exists (DB wins for cooldown_ms)
# RL_LOGIN_IP=10
# RL_SETTINGS_CACHE_MS=10000

# Extra usernames to block (comma-separated, lowercase)
# DISABLED_USERNAMES=demo_account,test_user

# bcrypt cost factor (10–12 recommended)
BCRYPT_ROUNDS=12

# ── Database (Railway / MySQL) — use ONE of these approaches ─────────
# Option A: single URL
DATABASE_URL=mysql://user:password@host:port/database

# Option B: individual variables (Railway often exposes these)
# MYSQLHOST=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# MYSQLPORT=3306

# ── One-off password hashing script ─────────────────────────────────
# ADMIN_NEW_PASSWORD=YourStr0ng!Pass12

# ── Razorpay UPI (Render — never expose KEY_SECRET to frontend) ─────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Payment limits (paise: 100 = ₹1)
# PAYMENT_MIN_PAISE=100
# PAYMENT_MAX_PAISE=50000000

# Fraud engine tuning
# FRAUD_VELOCITY_WINDOW_MIN=10
# FRAUD_VELOCITY_MAX=5
# FRAUD_HIGH_RISK_THRESHOLD=75
# FRAUD_BLOCK_THRESHOLD=90

# Rate limits
# PAYMENT_CREATE_RATE_MAX=20
# PAYMENT_VERIFY_RATE_MAX=40

# Logging
# LOG_LEVEL=info

# ── Security hardening ──────────────────────────────────────────────
# ENFORCE_HTTPS=true
# WEBHOOK_MAX_AGE_SEC=300
# HSTS_MAX_AGE=31536000
# ADMIN_IP_ALLOWLIST=
# ADMIN_SESSION_MAX_MIN=30
# DB_QUERY_TIMEOUT_MS=15000

# Optional third-party fraud (fallback to internal engine if disabled/unavailable)
# SOCURE_ENABLED=false
# SOCURE_API_KEY=
# SOCURE_BASE_URL=https://api.socure.com
# SARDINE_ENABLED=false
# SARDINE_API_KEY=
# SARDINE_BASE_URL=https://api.sardine.ai

# Rate limits (enterprise sliding window)
# RL_LOGIN_IP=10
# RL_PAY_CREATE_IP=20
# RL_WEBHOOK_IP=200
# RL_ADMIN_IP=60

# ── Local QA / security scripts (never commit real values) ──────────
# API_URL=http://localhost:3000
# TEST_USERNAME=
# TEST_PASSWORD=
