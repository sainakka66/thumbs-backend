      "name": "Authentication",
      "item": [
        {
          "name": "Health (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('login succeeded', () => pm.expect(res.success).to.be.true);",
                  "if (res.token) { pm.environment.set('token', res.token); }",
                  "if (res.role) { pm.environment.set('role', res.role); }",
                  "console.log('Token stored. Role:', res.role, 'Permissions:', (res.permissions||[]).length);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] }
          }
        },
        {
          "name": "Current User (rbac/me)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "const res = pm.response.json();",
              "if (res.user && res.user.id) pm.environment.set('userId', res.user.id);",
              "pm.test('has permissions', () => pm.expect(res).to.have.property('permissions'));"
            ] } }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/rbac/me", "host": ["{{baseUrl}}"], "path": ["rbac", "me"] }
          }
        },
