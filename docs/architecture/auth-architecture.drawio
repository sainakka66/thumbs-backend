        <mxCell id="15" value="RBAC UI gates
role: admin | distributor | user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="8"><mxGeometry x="20" y="810" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="16" value="POST /logout
Clears local JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="8"><mxGeometry x="20" y="920" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="17" value="Express API Gateway" style="swimlane;horizontal=0;startSize=32;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="160" width="360" height="1180" as="geometry"/></mxCell>
        <mxCell id="18" value="/auth/register (target)
Helmet → CORS → JSON → rateLimit → inputGuard → registerHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;dashed=1;dashPattern=8 8" vertex="1" parent="17"><mxGeometry x="20" y="50" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="19" value="POST /login
enterpriseLimiter.login → asyncHandler
No originGuard (core mount)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="17"><mxGeometry x="20" y="170" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="20" value="/auth/refresh (target)
Rotate JWT + session row" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;dashed=1;dashPattern=8 8" vertex="1" parent="17"><mxGeometry x="20" y="310" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="21" value="GET /session/validate (target)
verifyToken → session lookup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;dashed=1;dashPattern=8 8" vertex="1" parent="17"><mxGeometry x="20" y="410" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="22" value="POST /risk/analyze
mount: /risk + originGuard
verifyToken → loadAuthUser → riskAnalyzeLimiter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="17"><mxGeometry x="20" y="510" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="23" value="Protected DMS routes
verifyToken on /products, /customers, /sales
JWT claims: id, username, role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="17"><mxGeometry x="20" y="630" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="24" value="POST /logout
verifyToken (stateless)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="17"><mxGeometry x="20" y="790" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="25" value="Security Middleware Layer" style="swimlane;horizontal=0;startSize=32;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="760" y="160" width="400" height="1180" as="geometry"/></mxCell>
        <mxCell id="26" value="Execution order (payments mount):
1. httpsEnforce + HSTS
2. requestContext (IP, UA, X-Device-Fingerprint)
3. inputSanitizer (SQLi patterns)
4. originGuard (CSRF-style Origin/Referer)
5. verifyToken (JWT HS256)
6. loadAuthUser (DB reload)
7. role / rate limiters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="25"><mxGeometry x="20" y="50" width="360" height="200" as="geometry"/></mxCell>
        <mxCell id="27" value="JWT validation
SECRET, exp JWT_EXPIRES_IN
403 missing / 401 invalid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="25"><mxGeometry x="20" y="270" width="360" height="90" as="geometry"/></mxCell>
        <mxCell id="28" value="Rate limiting
enterpriseLimiter: IP/user/device/burst
Logs suspicious_activities on exceed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="25"><mxGeometry x="20" y="380" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="29" value="SQL injection protection
inputGuard + parameterized queries
safeQuery wrapper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="25"><mxGeometry x="20" y="500" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="30" value="CSRF / Origin protection
originGuard allowlist (non-GET)
JWT + credentials CORS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="25"><mxGeometry x="20" y="600" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="31" value="Geo/IP anomaly (payments)
deviceTrustService impossible_travel
security_incidents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="25"><mxGeometry x="20" y="700" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="32" value="Replay prevention
webhook_replay_guard (webhooks)
Idempotency keys (orders)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="25"><mxGeometry x="20" y="820" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="33" value="Session timeout
adminSessionTimeout (admin JWT iat)
JWT exp for all clients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="25"><mxGeometry x="20" y="920" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="34" value="Auth &amp; Risk Services" style="swimlane;horizontal=0;startSize=32;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1180" y="160" width="420" height="1180" as="geometry"/></mxCell>
        <mxCell id="35" value="Auth Service (server.js)
bcrypt verify + legacy upgrade
blocked: banned/suspended/deleted
isUsernameDisabled check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="34"><mxGeometry x="20" y="50" width="380" height="130" as="geometry"/></mxCell>
        <mxCell id="36" value="Device Trust Engine
deviceTrustService.js
blocked_devices, device_sessions
trustScore, emulator/headless flags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="34"><mxGeometry x="20" y="200" width="380" height="150" as="geometry"/></mxCell>
        <mxCell id="37" value="Risk Engine V2 (login-adjacent)
riskEngineV2 + riskOrchestrator
blocked_entities checks
velocity, multi-account device" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="34"><mxGeometry x="20" y="370" width="380" height="160" as="geometry"/></mxCell>
        <mxCell id="38" value="Fraud on Login (target)
Failed attempt tracking → suspicious_activities
Optional POST /risk/analyze pre-auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;dashed=1;dashPattern=8 8" vertex="1" parent="34"><mxGeometry x="20" y="550" width="380" height="120" as="geometry"/></mxCell>
        <mxCell id="39" value="Audit Logging
api_request_logs, admin_audit_logs
suspicious_activities inserts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="34"><mxGeometry x="20" y="690" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="40" value="RBAC
requireRole(admin) on /admin/*
JWT role claim + DB users.role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="34"><mxGeometry x="20" y="810" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="41" value="Session Store (schema-ready)
user_sessions, trusted_devices
SHA-256 session_token_hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;dashed=1;dashPattern=8 8" vertex="1" parent="34"><mxGeometry x="20" y="930" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="42" value="Authentication Sequence Flows" style="swimlane;horizontal=0;startSize=32;fillColor=#ffffff;strokeColor=#333333;fontStyle=1;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1680" y="160" width="640" height="1180" as="geometry"/></mxCell>
        <mxCell id="43" value="LOGIN FLOW (implemented)
1. Client POST /login {username,password}
2. loginLimiter (enterpriseLimiter)
3. SELECT users — status, is_active, deleted_at
4. bcrypt verify / legacy hash upgrade
5. jwt.sign({id,username,role}, exp)
6. Response {success, token}
Security: rate limit, account status, no user enumeration timing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="42"><mxGeometry x="20" y="50" width="600" height="280" as="geometry"/></mxCell>
        <mxCell id="44" value="REGISTRATION FLOW (target enterprise)
1. POST /auth/register + deviceSignals
2. Validate email/phone uniqueness
3. bcrypt hash password, INSERT users
4. INSERT user_sessions + trusted_devices
5. Issue JWT + refresh token
Tables: users, user_sessions, trusted_devices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;dashed=1;dashPattern=8 8" vertex="1" parent="42"><mxGeometry x="20" y="350" width="600" height="200" as="geometry"/></mxCell>
        <mxCell id="45" value="SESSION VALIDATION (target)
1. GET /session/validate Bearer JWT
2. verifyToken → load session hash
3. Check expires_at, is_active
4. Device fingerprint match
5. 200 {valid, user, session} | 401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;dashed=1;dashPattern=8 8" vertex="1" parent="42"><mxGeometry x="20" y="570" width="600" height="180" as="geometry"/></mxCell>
        <mxCell id="46" value="RISK AT AUTH (payment path)
POST /risk/analyze {amount, customerId?}
→ fraudEngine.analyzePaymentRisk
→ deviceTrustService.evaluateDeviceTrust
Tables: blocked_*, user_risk_scores, suspicious_activities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="42"><mxGeometry x="20" y="770" width="600" height="200" as="geometry"/></mxCell>
        <mxCell id="47" value="BLOCKED FLOW (red path)
blocked_entities / banned status
→ 403 Invalid credentials OR PaymentBlockedError
→ suspicious_activities + security_incidents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="42"><mxGeometry x="20" y="990" width="600" height="120" as="geometry"/></mxCell>
        <mxCell id="48" value="users
id, username, password, email, phone
role, status, is_active, deleted_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11" vertex="1" parent="1"><mxGeometry x="80" y="1430" width="400" height="200" as="geometry"/></mxCell>
        <mxCell id="49" value="user_sessions (schema-ready)
session_token_hash, device_fingerprint
expires_at, last_seen_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;dashed=1;dashPattern=8 8" vertex="1" parent="1"><mxGeometry x="520" y="1430" width="400" height="200" as="geometry"/></mxCell>
